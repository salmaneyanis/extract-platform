# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=mydb

# Extract Service (Docling : classic + vlm)
EXTRACT_DEFAULT_ENGINE=vlm
VLM_MODEL_ID=nanonets/Nanonets-OCR2-3B
VLM_MAX_NEW_TOKENS=4096
EXTRACT_WORKERS=1
EXTRACT_DEFAULT_DEVICE=auto
EXTRACT_MAX_FILE_SIZE_MB=100
EXTRACT_TIMEOUT_SECONDS=1200
